# Canonical production URL (no trailing slash). Used for canonical tags,
# Open Graph, sitemap.xml, robots.txt, and JSON-LD structured data.
NEXT_PUBLIC_SITE_URL=https://www.aryamanawasthi.com

# Google Search Console verification token (the content value of the
# HTML-tag verification method). Optional — only needed if you verify
# ownership via meta tag instead of DNS.
GOOGLE_SITE_VERIFICATION=
